# Node.js 22+，复制为 .env 后按需填写。不要提交 .env。
PORT=3030
HOST=0.0.0.0
LLM_API_KEY=your-api-key-here
LLM_API_URL=https://your-llm-endpoint.example/v1/chat/completions
LLM_MODEL=your-base-model
LLM_ADVANCED_MODEL=your-advanced-model
LLM_REFLECTION_MODEL=your-reflection-model
# 0 disables the LLM request timeout; set a positive value to limit requests in milliseconds.
LLM_TIMEOUT_MS=0
LLM_REASONING_EFFORTS=low,high,max
LLM_REQUEST_EXTRA_JSON={}
LLM_MEMORY_DIR=data/ai-memory/llm-advanced
# HTTPS 反向代理部署时启用；本地 HTTP 请保持 false。
COOKIE_SECURE=false
LLM_LOG_ENABLED=true
LLM_LOG_DIR=data/logs/llm
# 配置后，昵称完全匹配时创建房间会自动补 AI 并自动开始对局；留空则关闭。
DEBUG_AUTO_PLAY_NAME=
DEBUG_AUTO_PLAY_MODE=llm-advanced
DEBUG_AUTO_PLAY_DELAY_MS=900
DEBUG_AUTO_PLAY_MAX_TURNS=200
DEBUG_AUTO_PLAY_SAVE_EXPERIENCE=false
