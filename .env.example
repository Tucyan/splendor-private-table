# Node.js 22+，复制为 .env 后按需填写。不要提交 .env。
PORT=3030
HOST=0.0.0.0
LLM_API_KEY=your-api-key-here
LLM_API_URL=https://your-llm-endpoint.example/v1/chat/completions
LLM_MODEL=your-base-model
LLM_ADVANCED_MODEL=your-advanced-model
LLM_REFLECTION_MODEL=your-reflection-model
LLM_TIMEOUT_MS=20000
LLM_REQUEST_EXTRA_JSON={}
LLM_MEMORY_DIR=data/ai-memory/llm-advanced
# HTTPS 反向代理部署时启用；本地 HTTP 请保持 false。
COOKIE_SECURE=false
