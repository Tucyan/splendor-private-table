[Unit]
Description=Splendor Private Table
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=splendor
Group=splendor
WorkingDirectory=/opt/splendor
EnvironmentFile=/etc/splendor.env
ExecStart=/opt/node-v24.11.1-linux-x64/bin/node /opt/splendor/src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
